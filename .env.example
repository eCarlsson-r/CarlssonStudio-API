# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=carlssonstudio_db
DB_USERNAME=
DB_PASSWORD=
# Mail
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_NOTIFICATION_TO=
MAIL_FROM=
MAIL_FROM_NAME=Carlsson Studio
# CORS
CORS_ORIGINS=http://localhost:3000,https://carlssonstudio.com
PROPOSALS_PATH=/path/to/proposals/storage
JWT_SECRET=your-secret-key-minimum-32-characters
JWT_EXPIRATION_MS=86400000
# WhatsApp Business Cloud API — see docs/whatsapp-setup.md
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=lead_followup
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v20.0
# Meta Conversions API — same Pixel ID as the frontend's
# NEXT_PUBLIC_META_PIXEL_ID; ENABLED stays false until an access token
# (system user, ads_management permission) is generated.
META_CAPI_ENABLED=false
META_PIXEL_ID=1069018588967069
META_CAPI_ACCESS_TOKEN=
META_CAPI_API_VERSION=v20.0
META_CAPI_EVENT_SOURCE_URL=https://carlssonstudio.com/start-a-project
META_CAPI_TEST_EVENT_CODE=